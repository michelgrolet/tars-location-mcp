# Copy to ~/.config/tars-location/.env, or point LOCATION_ENV_FILE somewhere else.
# A real environment variable always beats this file.

# Required. Any Postgres 13+: a container on this laptop, or a hosted project.
LOCATION_DATABASE_URL=postgresql://postgres:local@127.0.0.1:5432/postgres

# Required before anything geocodes. Nominatim's usage policy asks for an address they can
# reach you at; without one you are an anonymous scraper to them.
LOCATION_GEOCODER_CONTACT=you@example.com

# Where you are when the archive cannot say yet. Only decides what "yesterday" means on an
# empty database. Default UTC.
LOCATION_FALLBACK_TZ=Europe/Paris

# A phone at rest wanders a few metres, so anything inside this radius is the same place.
# Much wider merges a house with its neighbour. Default 40.
LOCATION_PLACE_RADIUS_M=40

# Nominatim allows one request per second, absolute. Default 1.1.
LOCATION_GEOCODE_SLEEP_S=1.1

# Hard cap on what location_sql can return, whatever limit the caller asks for. Default 2000.
LOCATION_READ_ONLY_ROW_CAP=2000

# Weather. Open-Meteo is free for non-commercial use and needs no key, so none of these
# have to be set. metric or imperial: °C/km/h/mm against °F/mph/inch. Default metric.
LOCATION_WEATHER_UNITS=metric

# Seconds before a weather call gives up. Default 15.
LOCATION_WEATHER_TIMEOUT_S=15

# Only if you have an Open-Meteo commercial plan. Empty means the free endpoints.
LOCATION_WEATHER_API_KEY=
